GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CHROMA_PERSIST_DIR=./data/chroma

CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RELEVANCE_MAX_DISTANCE=0.33

LLM_TEMPERATURE=0.0
API_MAX_RETRIES=3

# Read by the container entrypoint, not by app/config.py
HOST=0.0.0.0
PORT=8000

# Read by LangSmith auto-instrumentation if any is pulled in transitively.
# The application itself has no setting for it.
LANGSMITH_TRACING=false
